<Window x:Class="Cipher.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📖 About Cipher" 
        Height="550" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Main Container with Rounded Corners -->
    <Border Background="#12121E" 
            CornerRadius="12,12,12,12" 
            BorderBrush="#282840" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== TITLE BAR ===== -->
            <Border Grid.Row="0" Background="#1E1E32" CornerRadius="12,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="📖 About Cipher" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Foreground="#DCE0F0"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>

                    <Button Grid.Column="1" 
                            Content="✕" 
                            Width="28" Height="28" 
                            FontSize="14"
                            Background="Transparent" 
                            Foreground="#8A8AA0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,12,0"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E74C4C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== CONTENT ===== -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="#12121E"
                          Margin="20,16,20,16">
                <StackPanel>
                    <!-- App Icon -->
                    <TextBlock Text="🔐" 
                               FontSize="64" 
                               HorizontalAlignment="Center"
                               Foreground="#DCE0F0"
                               Margin="0,10,0,10"/>

                    <!-- App Name -->
                    <TextBlock Text="Cipher" 
                               FontFamily="Segoe UI"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#DCE0F0"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <!-- Tagline -->
                    <TextBlock Text="Mod Loader &amp; Injector" 
                               FontFamily="Segoe UI"
                               FontSize="14"
                               Foreground="#969BB4"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Divider -->
                    <Border Height="1" Background="#282840" Margin="0,0,0,16"/>

                    <!-- Version -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Version:" 
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#969BB4"/>
                        <TextBlock Grid.Column="1" 
                                   Text="1.0.15" 
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="#DCE0F0"/>
                    </Grid>

                    <!-- Build Date -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Build:" 
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#969BB4"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding BuildDate}" 
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="#DCE0F0"/>
                    </Grid>

                    <!-- License -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="License:" 
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#969BB4"/>
                        <TextBlock Grid.Column="1" 
                                   Text="MIT" 
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="#89B4FA"/>
                    </Grid>

                    <!-- Framework -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Framework:" 
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#969BB4"/>
                        <TextBlock Grid.Column="1" 
                                   Text=".NET Framework 4.7.2" 
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="#DCE0F0"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="#282840" Margin="0,0,0,16"/>

                    <!-- Description -->
                    <TextBlock TextWrapping="Wrap"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#B4B9D2"
                               Margin="0,0,0,8">
                        <Run Text="A modern, open-source Windows application for managing,"/>
                        <Run Text="downloading and injecting mod DLLs into Processes using LoadLibraryA and CreateRemoteThread."/>
                    </TextBlock>

                    <!-- GitHub Link -->
                    <Border Background="#1A1A2A" 
                            CornerRadius="8" 
                            Padding="12,10,12,10"
                            Margin="0,8,0,0"
                            Cursor="Hand"
                            MouseLeftButtonDown="GitHubLink_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="🐙 Check out the project on Github!" 
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#89B4FA"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" 
                                       Text="→" 
                                       FontFamily="Segoe UI"
                                       FontSize="14"
                                       Foreground="#89B4FA"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="2" Background="#16162A" CornerRadius="0,0,12,12" Padding="16,12,16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="© 2026 Cipher Team" 
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#787D96"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1" 
                            Content="Close"
                            Width="80" 
                            Height="32"
                            Background="#89B4FA"
                            Foreground="#12121E"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="8,4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#74C7EC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>