<Window x:Class="Cipher.AddModDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="➕ Add New Mod" 
        Height="320" 
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Main Container with Rounded Corners -->
    <Border Background="#12121E" 
            CornerRadius="12,12,12,12" 
            BorderBrush="#282840" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== TITLE BAR ===== -->
            <Border Grid.Row="0" Background="#1E1E32" CornerRadius="12,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="➕ Add New Mod" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Foreground="#DCE0F0"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>

                    <Button Grid.Column="1" 
                            Content="✕" 
                            Width="28" Height="28" 
                            FontSize="14"
                            Background="Transparent" 
                            Foreground="#8A8AA0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,12,0"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E74C4C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== FORM CONTENT ===== -->
            <Grid Grid.Row="1" Margin="20,20,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Mod Name -->
                <TextBlock Grid.Row="0" Text="Mod Name:" Foreground="#969BB4" Margin="0,0,0,4" FontFamily="Segoe UI" FontSize="12"/>
                <TextBox Grid.Row="1" x:Name="NameTextBox" 
                         Background="#1A1A2A" 
                         Foreground="#DCE0F0"
                         BorderBrush="#32324A"
                         BorderThickness="1"
                         Padding="8"
                         Margin="0,0,0,12"
                         FontFamily="Segoe UI"
                         KeyDown="HandleKeyDown"/>

                <!-- Game Task -->
                <TextBlock Grid.Row="2" Text="Game Task (e.g., RDR2.exe):" Foreground="#969BB4" Margin="0,0,0,4" FontFamily="Segoe UI" FontSize="12"/>
                <TextBox Grid.Row="3" x:Name="GameTextBox" 
                         Background="#1A1A2A" 
                         Foreground="#DCE0F0"
                         BorderBrush="#32324A"
                         BorderThickness="1"
                         Padding="8"
                         Margin="0,0,0,12"
                         FontFamily="Segoe UI"
                         KeyDown="HandleKeyDown"/>

                <!-- Download URL -->
                <TextBlock Grid.Row="4" Text="Download URL:" Foreground="#969BB4" Margin="0,0,0,4" FontFamily="Segoe UI" FontSize="12"/>
                <TextBox Grid.Row="5" x:Name="UrlTextBox" 
                         Background="#1A1A2A" 
                         Foreground="#DCE0F0"
                         BorderBrush="#32324A"
                         BorderThickness="1"
                         Padding="8"
                         Margin="0,0,0,16"
                         FontFamily="Segoe UI"
                         KeyDown="HandleKeyDown"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Cancel" 
                            Width="80" Height="32"
                            Background="#32324A"
                            Foreground="#DCE0F0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="8,4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#42425A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Add Mod" 
                            Width="80" Height="32"
                            Background="#89B4FA"
                            Foreground="#12121E"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="10,0,0,0"
                            Click="AddButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="8,4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#74C7EC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>