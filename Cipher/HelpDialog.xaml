<Window x:Class="Cipher.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚠️ Help - Antivirus Exclusion Guide" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Main Container with Rounded Corners -->
    <Border Background="#12121E" 
            CornerRadius="12,12,12,12" 
            BorderBrush="#282840" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== TITLE BAR ===== -->
            <Border Grid.Row="0" Background="#1E1E32" CornerRadius="12,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="⚠️ Help - Antivirus Exclusion Guide" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Foreground="#DCE0F0"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>

                    <Button Grid.Column="1" 
                            Content="✕" 
                            Width="28" Height="28" 
                            FontSize="14"
                            Background="Transparent" 
                            Foreground="#8A8AA0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,12,0"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E74C4C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== CONTENT ===== -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="#12121E"
                          Margin="20,16,20,16">
                <StackPanel>
                    <!-- Warning Icon -->
                    <TextBlock Text="⚠️" 
                               FontSize="48" 
                               HorizontalAlignment="Center"
                               Foreground="Orange"
                               Margin="0,0,0,12"/>

                    <!-- Title -->
                    <TextBlock Text="Is your Antivirus Triggering from Cipher?"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#DCE0F0"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <!-- Description -->
                    <TextBlock TextWrapping="Wrap"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="#B4B9D2"
                               Margin="0,0,0,16">
                        <Run Text="Cipher comes with 3 pre-configured mods for RDR2, GTA 5 Legacy, and GTA 5 Enhanced. "/>
                        <Run Text="These are open-source DLL files that may be flagged by your antivirus as a false positive. "/>
                        <Run Text="You can safely delete these mods from Cipher and add your own but you will likely still need to add an exclusion to the Cipher folder in your APPDATA folder"/>
                    </TextBlock>

                    <TextBlock Text="To find APPDATA -> Open File Explorer -> Type %APPDATA% into the top bar and press ENTER then locate the Cipher folder"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#DCE0F0"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- Divider -->
                    <Border Height="1" Background="#282840" Margin="0,8,0,16"/>

                    <!-- Step-by-step Guide -->
                    <TextBlock Text="🛡️ How to Add an Antivirus Exclusion (Windows Defender)"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#DCE0F0"
                               Margin="0,0,0,12"/>

                    <TextBlock TextWrapping="Wrap"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#B4B9D2"
                               LineHeight="22">
                        <Run Text="1. "/><Run Text="Open Windows Security" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="2. "/><Run Text="Click 'Virus &amp; threat protection'" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="3. "/><Run Text="Click 'Manage settings' (under Virus &amp; threat protection settings)" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="4. "/><Run Text="Scroll down to 'Exclusions'" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="5. "/><Run Text="Click 'Add or remove exclusions'" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="6. "/><Run Text="Click 'Add an exclusion' → Select 'Folder'" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="7. "/><Run Text="Browse to: " FontWeight="Bold"/>
                        <Run Text="%APPDATA%" Foreground="#89B4FA" FontWeight="Bold"/>
                        <Run Text=" (Top bar) -> Click Cipher folder -> Press Open (Bottom right)" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="8. "/><Run Text="Confirm and close Windows Security" FontWeight="Bold"/>
                    </TextBlock>

                    <!-- Divider -->
                    <Border Height="1" Background="#282840" Margin="0,16,0,16"/>

                    <!-- Note -->
                    <Border Background="#1A1A2A" 
                            CornerRadius="8" 
                            Padding="12"
                            Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="#F9E2AF">
                            <Run Text="✅ "/>
                            <Run Text="After adding the exclusion, click 'Download' on each mod to download them."/>
                        </TextBlock>
                    </Border>

                    <Border Background="#1A1A2A" 
                            CornerRadius="8" 
                            Padding="12">
                        <TextBlock TextWrapping="Wrap"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="#89B4FA">
                            <Run Text="⚠️ "/>
                            <Run Text="Note: All pre-added mods are open source, fully tested, and safe to use."/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="2" Background="#16162A" CornerRadius="0,0,12,12" Padding="16,12,16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Need more help? Visit the GitHub repository for support."
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#787D96"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1" 
                            Content="Close"
                            Width="80" 
                            Height="32"
                            Background="#89B4FA"
                            Foreground="#12121E"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="8,4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#74C7EC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>