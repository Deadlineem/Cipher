<Window x:Class="Cipher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cipher 🔐 Mod Loader/Injector" Height="750" Width="1100"
        MinHeight="600" MinWidth="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ===== TITLE BAR ===== -->
        <Border Grid.Row="0" Background="#1A1A2E" CornerRadius="10,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock 
                               Text="Cipher" 
                               FontFamily="Segoe UI" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="#89B4FA"
                               VerticalAlignment="Center"/>
                    <TextBlock 
                               Text=" 🔐 " 
                               FontFamily="Segoe UI" 
                               FontSize="14"
                               Foreground="#6C7086"
                               VerticalAlignment="Center"/>
                    <TextBlock 
                               Text="Mod Loader" 
                               FontFamily="Segoe UI" 
                               FontSize="13"
                               Foreground="#A6ADC8"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <TextBlock 
                               Text="/" 
                               FontFamily="Segoe UI" 
                               FontSize="13"
                               Foreground="#45475A"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <TextBlock 
                               Text="Injector" 
                               FontFamily="Segoe UI" 
                               FontSize="13"
                               Foreground="#A6ADC8"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0">
                    <!-- Minimize Button -->
                    <Button Content="─" 
                            Width="30" Height="30" 
                            FontSize="14" FontWeight="Light"
                            Background="Transparent" 
                            Foreground="#6C7086"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MinimizeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#313244"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximize/Restore Button -->
                    <Button x:Name="MaximizeButton"
                            Content="☐"
                            Width="30" Height="30" 
                            FontSize="13"
                            Background="Transparent" 
                            Foreground="#6C7086"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MaximizeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#313244"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close Button -->
                    <Button Content="✕" 
                            Width="30" Height="30" 
                            FontSize="13"
                            Background="Transparent" 
                            Foreground="#6C7086"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="4,0,0,0"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F38BA8"/>
                                        <Setter Property="Foreground" Value="#1A1A2E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TOOLBAR ===== -->
        <Border Grid.Row="1" Background="#11111B" BorderBrush="#1E1E2E" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Button Content="➕ Add Mod" 
                            Background="#89B4FA" 
                            Foreground="#11111B"
                            FontFamily="Segoe UI" 
                            FontSize="12" 
                            FontWeight="SemiBold"
                            Padding="16,8,16,8"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Click="AddModButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#74C7EC"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="💉 Inject Selected" 
                            Background="#CBA6F7" 
                            Foreground="#11111B"
                            FontFamily="Segoe UI" 
                            FontSize="12" 
                            FontWeight="SemiBold"
                            Padding="16,8,16,8"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Click="InjectButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5C2E7"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🗑 Delete" 
                            Background="#F38BA8" 
                            Foreground="#11111B"
                            FontFamily="Segoe UI" 
                            FontSize="12" 
                            FontWeight="SemiBold"
                            Padding="16,8,16,8"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Click="RemoveButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EBA0AC"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Border Width="1" Background="#313244" Margin="8,4,12,4"/>

                    <Button Content="📖 About" 
                            Background="Transparent" 
                            Foreground="#A6ADC8"
                            FontFamily="Segoe UI" 
                            FontSize="12" 
                            FontWeight="Medium"
                            Padding="12,8,12,8"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            Click="AboutButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#313244"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="❓ Help" 
                            Background="Transparent" 
                            Foreground="#A6ADC8"
                            FontFamily="Segoe UI" 
                            FontSize="12" 
                            FontWeight="Medium"
                            Padding="12,8,12,8"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            Click="ShowExclusionGuide_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#313244"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🔄 Update Cipher" 
                            Background="Transparent" 
                            Foreground="#A6ADC8"
                            FontFamily="Segoe UI" 
                            FontSize="12" 
                            FontWeight="Medium"
                            Padding="12,8,12,8"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            Click="UpdateAppButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#313244"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== MOD LIST ===== -->
        <Border Grid.Row="2" Background="#11111B" Padding="20,12,20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#1A1A2E" CornerRadius="6,6,0,0">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="2.8*"/>
                            <ColumnDefinition Width="1.8*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock 
                                   Text="MOD NAME" 
                                   Foreground="#6C7086" 
                                   FontFamily="Segoe UI" 
                                   FontSize="10" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="1" 
                                   Text="INJECT TO" 
                                   Foreground="#6C7086" 
                                   FontFamily="Segoe UI" 
                                   FontSize="10" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="2" 
                                   Text="UPDATE STATUS" 
                                   Foreground="#6C7086" 
                                   FontFamily="Segoe UI" 
                                   FontSize="10" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="3" 
                                   Text="PROCESS DETECTION" 
                                   Foreground="#6C7086" 
                                   FontFamily="Segoe UI" 
                                   FontSize="10" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="4" 
                                   Text="QUICK ACTIONS" 
                                   Foreground="#6C7086" 
                                   FontFamily="Segoe UI" 
                                   FontSize="10" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Mod List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="ModListBox"
                             ItemsSource="{Binding Mods}"
                             Background="#1A1A2E"
                             BorderThickness="0"
                             Foreground="#CDD6F4"
                             FontFamily="Segoe UI"
                             FontSize="13"
                             SelectionChanged="ModListBox_SelectionChanged"
                             MouseDoubleClick="ModListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" 
                                        CornerRadius="6" 
                                        Margin="2,1,2,1"
                                        Padding="8,8,8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.8*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="2.8*"/>
                                            <ColumnDefinition Width="1.8*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mod Name -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding DisplayName}" 
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}"/>

                                        <!-- Game Task -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding GameTask}" 
                                                   VerticalAlignment="Center"
                                                   Foreground="#6C7086"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding GameTask}"/>

                                        <!-- Mod Status Badge -->
                                        <Border Grid.Column="2" 
                                                Background="{Binding StatusColor}" 
                                                CornerRadius="12"
                                                Padding="8,3,8,3"
                                                Height="22"
                                                Width="80"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" 
                                                       Foreground="#11111B"
                                                       FontFamily="Segoe UI"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <!-- Process Status Indicator -->
                                        <Border Grid.Column="3" 
                                                Background="{Binding ProcessColor}" 
                                                CornerRadius="12"
                                                Padding="8,3,8,3"
                                                Height="22"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessStatusText}" 
                                                       Foreground="#11111B"
                                                       FontFamily="Segoe UI"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ProcessStatusText}"/>
                                        </Border>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="4" 
                                                    Orientation="Horizontal" 
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,0">
                                            <Button Content="🎮 Start" 
                                                    Background="#89B4FA" 
                                                    Foreground="#11111B"
                                                    FontFamily="Segoe UI"
                                                    Margin="0,0,4,0"
                                                    FontSize="8" 
                                                    FontWeight="SemiBold"
                                                    Padding="6,4,6,4"
                                                    Cursor="Hand"
                                                    Click="StartGameButton_Click"
                                                    Tag="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            CornerRadius="4"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#74C7EC"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="⬇ Download" 
                                                    Background="#A6E3A1" 
                                                    Foreground="#11111B"
                                                    FontFamily="Segoe UI" 
                                                    FontSize="8" 
                                                    FontWeight="SemiBold"
                                                    Padding="6,4,6,4"
                                                    Margin="0,0,4,0"
                                                    Cursor="Hand"
                                                    Click="DownloadModButton_Click"
                                                    Tag="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            CornerRadius="4"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#94E2D5"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="💉 Inject" 
                                                    Background="#CBA6F7" 
                                                    Foreground="#11111B"
                                                    FontFamily="Segoe UI" 
                                                    FontSize="8" 
                                                    FontWeight="SemiBold"
                                                    Padding="6,4,6,4"
                                                    Cursor="Hand"
                                                    Click="InjectModButton_Click"
                                                    Tag="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            CornerRadius="4"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F5C2E7"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter Content="{TemplateBinding Content}" 
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#313244"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#28283A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="3" Background="#1A1A2E" CornerRadius="0,0,0,0" BorderBrush="#1E1E2E" BorderThickness="0,1,0,0">
            <Grid Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" 
                           x:Name="ModCountText"
                           Text="📊 0 mods" 
                           Foreground="#585B70"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ===== BRANDING / FOOTER ===== -->
        <Border Grid.Row="4" Background="#0E0E1A" CornerRadius="0,0,10,10" BorderBrush="#1A1A2E" BorderThickness="0,1,0,0">
            <Grid Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Branding Text - Left -->
                <TextBlock Grid.Column="0" 
                           Text="Cipher 🔐 - Open Source Mod Loader/Injector" 
                           Foreground="#5A5A72"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <!-- GitHub Link - Center -->
                <Button Grid.Column="1"
                        Content="🐙 GitHub"
                        Background="Transparent"
                        Foreground="#89B4FA"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="GitHubButton_Click"
                        Padding="8,2,8,2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="4">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#74C7EC"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Version / Build Info - Right -->
                <TextBlock Grid.Column="2" 
                           Text="{Binding BuildVer}" 
                           Foreground="#3A3A52"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>