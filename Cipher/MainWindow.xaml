<Window x:Class="Cipher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cipher 🔐 Mod Loader/Injector" Height="750" Width="1100"
        MinHeight="600" MinWidth="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ===== TITLE BAR ===== -->
        <Border Grid.Row="0" Background="#1E1E32" CornerRadius="8,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Cipher 🔐 Mod Loader/Injector" 
                           FontFamily="Segoe UI" 
                           FontSize="16" 
                           FontWeight="Bold"
                           Foreground="#DCE0F0"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                    <!-- Minimize Button -->
                    <Button Content="─" 
                            Width="28" Height="28" 
                            FontSize="16"
                            Background="Transparent" 
                            Foreground="#8A8AA0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MinimizeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3A3A52"/>
                                        <Setter Property="Foreground" Value="#DCE0F0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximize/Restore Button -->
                    <Button x:Name="MaximizeButton"
                            Content="☐"
                            Width="28" Height="28" 
                            FontSize="14"
                            Background="Transparent" 
                            Foreground="#8A8AA0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MaximizeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3A3A52"/>
                                        <Setter Property="Foreground" Value="#DCE0F0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close Button -->
                    <Button Content="✕" 
                            Width="28" Height="28" 
                            FontSize="14"
                            Background="Transparent" 
                            Foreground="#8A8AA0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="6,0,0,0"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E74C4C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TOOLBAR ===== -->
        <Border Grid.Row="1" Background="#12121E" BorderBrush="#282840" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Button Content="➕ Add Mod" 
                        Background="#89B4FA" 
                        Foreground="#12121E"
                        FontFamily="Segoe UI" 
                        FontSize="13" 
                        FontWeight="Bold"
                        Padding="14,8,14,8"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        Click="AddModButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#74C7EC"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#89B4FA" Opacity="0.3"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="💉 Inject Selected" 
                        Background="#CBA6F7" 
                        Foreground="#12121E"
                        FontFamily="Segoe UI" 
                        FontSize="13" 
                        FontWeight="Bold"
                        Padding="14,8,14,8"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        Click="InjectButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5C2E7"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#CBA6F7" Opacity="0.3"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="🗑 Delete Selected" 
                        Background="#F38BA8" 
                        Foreground="#12121E"
                        FontFamily="Segoe UI" 
                        FontSize="13" 
                        FontWeight="Bold"
                        Padding="14,8,14,8"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        Click="RemoveButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EBA0AC"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#F38BA8" Opacity="0.3"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="📖 About" 
                        Background="#89B4FA" 
                        Foreground="#12121E"
                        FontFamily="Segoe UI" 
                        FontSize="13" 
                        FontWeight="Bold"
                        Padding="14,8,14,8"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        Click="AboutButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#74C7EC"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#89B4FA" Opacity="0.3"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="⚠️ Help" 
        Background="#F9E2AF" 
        Foreground="#12121E"
        FontFamily="Segoe UI" 
        FontSize="13" 
        FontWeight="Bold"
        Padding="14,8,14,8"
        Margin="0,0,10,0"
        Cursor="Hand"
        Click="ShowExclusionGuide_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FCE8C0"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#F9E2AF" Opacity="0.3"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="⚠️ Update Cipher" 
        Background="#FFAFF9B7" 
        Foreground="#12121E"
        FontFamily="Segoe UI" 
        FontSize="13" 
        FontWeight="Bold"
        Padding="14,8,14,8"
        Margin="0,0,10,0"
        Cursor="Hand"
        Click="UpdateAppButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFE0FCC0"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#FFD3F9AF" Opacity="0.3"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== MOD LIST ===== -->
        <Border Grid.Row="2" Background="#12121E" Padding="20,12,20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#1A1A2A" CornerRadius="8,8,0,0">
                    <Grid Margin="12,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="222*"/>
                            <ColumnDefinition Width="178*"/>
                            <ColumnDefinition Width="148*"/>
                            <ColumnDefinition Width="307*"/>
                            <ColumnDefinition Width="181*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock 
                                   Text="Mod Name" 
                                   Foreground="#969BB4" 
                                   FontFamily="Segoe UI" 
                                   FontSize="11" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Height="14" Width="58"/>

                        <TextBlock Grid.Column="1" 
                                   Text="Inject To" 
                                   Foreground="#969BB4" 
                                   FontFamily="Segoe UI" 
                                   FontSize="11" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Height="14" Width="44"/>

                        <TextBlock Grid.Column="2" 
                                   Text="Update Status" 
                                   Foreground="#969BB4" 
                                   FontFamily="Segoe UI" 
                                   FontSize="11" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Height="14" Width="72" Margin="8,0,0,0"/>

                        <TextBlock Grid.Column="3" 
                                   Text="Process Detection Status" 
                                   Foreground="#969BB4" 
                                   FontFamily="Segoe UI" 
                                   FontSize="11" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Height="14" Width="128" Margin="60,0,0,0"/>

                        <TextBlock Grid.Column="4" 
                                   Text="Quick Actions" 
                                   Foreground="#969BB4" 
                                   FontFamily="Segoe UI" 
                                   FontSize="11" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Height="14" Width="72"/>
                    </Grid>
                </Border>

                <!-- Mod List -->
                <ListBox Grid.Row="1" 
                         x:Name="ModListBox"
                         ItemsSource="{Binding Mods}"
                         Background="#1A1A2A"
                         BorderThickness="0"
                         Foreground="#DCE0F0"
                         FontFamily="Segoe UI"
                         FontSize="13"
                         SelectionChanged="ModListBox_SelectionChanged"
                         MouseDoubleClick="ModListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" 
                                    CornerRadius="8" 
                                    Margin="4,2,4,2"
                                    Padding="12,6,12,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="0.6*"/>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Mod Name -->
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding DisplayName}" 
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <!-- Game Task -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding GameTask}" 
                                               VerticalAlignment="Center"
                                               Foreground="#969BB4"
                                               HorizontalAlignment="Center"/>

                                    <!-- Mod Status Badge -->
                                    <Border Grid.Column="2" 
                                            Background="{Binding StatusColor}" 
                                            CornerRadius="14"
                                            Padding="4,2,4,2"
                                            Height="22"
                                            Width="100"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" 
                                                   Foreground="#12121E"
                                                   FontFamily="Segoe UI"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Process Status Indicator -->
                                    <Border Grid.Column="3" 
                                            Background="{Binding ProcessColor}" 
                                            CornerRadius="14"
                                            Padding="12,4,12,4"
                                            Height="22"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ProcessStatusText}" 
                                                   Foreground="#12121E"
                                                   FontFamily="Segoe UI"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="4" 
                                                Orientation="Horizontal" 
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,0">
                                        <Button Content="🎮 Start Game" 
                                                Background="#CBA6F7" 
                                                Foreground="#12121E"
                                                FontFamily="Segoe UI"
                                                Margin="0,0,3,0"
                                                FontSize="9" 
                                                FontWeight="Bold"
                                                Padding="6,4,6,4"
                                                Cursor="Hand"
                                                Click="StartGameButton_Click"
                                                Tag="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        CornerRadius="6"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F5C2E7"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="⬇ Download" 
                                                Background="#A6E3A1" 
                                                Foreground="#12121E"
                                                FontFamily="Segoe UI" 
                                                FontSize="9" 
                                                FontWeight="Bold"
                                                Padding="6,4,6,4"
                                                Margin="0,0,3,0"
                                                Cursor="Hand"
                                                Click="DownloadModButton_Click"
                                                Tag="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        CornerRadius="6"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#94E2D5"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="💉 Inject" 
                                                Background="#CBA6F7" 
                                                Foreground="#12121E"
                                                FontFamily="Segoe UI" 
                                                FontSize="9" 
                                                FontWeight="Bold"
                                                Padding="6,4,6,4"
                                                Cursor="Hand"
                                                Click="InjectModButton_Click"
                                                Tag="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        CornerRadius="6"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F5C2E7"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter Content="{TemplateBinding Content}" 
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2A2A4E"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#24243E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="3" Background="#16162A" CornerRadius="0,0,0,0">
            <Grid Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           x:Name="StatusText"
                           Text="✅ Ready" 
                           Foreground="#B4B9D2"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" 
                           x:Name="ModCountText"
                           Text="📊 0 mods" 
                           Foreground="#787D96"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== BRANDING / FOOTER ===== -->
        <Border Grid.Row="4" Background="#0E0E1A" CornerRadius="0,0,8,8" BorderBrush="#282840" BorderThickness="0,1,0,0">
            <Grid Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Branding Text -->
                <TextBlock Grid.Column="0" 
                           Text="Cipher 🔐 - Open Source Mod Loader/Injector" 
                           Foreground="#5A5A72"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <!-- GitHub Link -->
                <Button
                        Content="🐙 GitHub"
                        Background="Transparent"
                        Foreground="#89B4FA"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="GitHubButton_Click"
                        Margin="503,6,250,4">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="4">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#74C7EC"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Version / Build Info -->
                <TextBlock Grid.Column="2" 
                           Text="{Binding BuildVer}" 
                           Foreground="#3A3A52"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>